{
  "$meta": {
    "name": "english-coach design tokens",
    "version": "1.0.0-d2a",
    "direction": "R2-C 夜幕焦點（D1 2026-11-26 決定）",
    "format": "見 docs/design/DESIGN.md §11（U-4）。群組固定為 color、space、radius、font、shadow、motion；輸出 CSS 變數 --<群組>-<名稱>。值是字串＝深淺色共用；值是 {light, dark}＝分兩段輸出。名稱只用小寫英數與 -。以 $ 開頭的鍵是說明，產生器一律略過。",
    "themes": "light 是 :root；dark 同時輸出到 @media (prefers-color-scheme: dark) :root:not([data-theme=light]) 與 :root[data-theme=dark]（ADR-014）"
  },
  "color": {
    "bg":           { "light": "#F4F5F7", "dark": "#0A1420" },
    "surface":      { "light": "#FFFFFF", "dark": "#13202F" },
    "sunken":       { "light": "#EEF0F3", "dark": "#0E1926" },
    "raised":       { "light": "#FFFFFF", "dark": "#2A3B50" },
    "ink":          { "light": "#0F2236", "dark": "#F3F5F8" },
    "ink-2":        { "light": "#56657A", "dark": "#A7B1BF" },
    "ink-3":        { "light": "#5F6E82", "dark": "#7D8DA3" },
    "line":         { "light": "#E3E6EB", "dark": "#223246" },
    "track":        { "light": "#DCE1E8", "dark": "#2A3B50" },
    "hero":         { "light": "#0F2236", "dark": "#1A2E45" },
    "hero-2":       { "light": "#1C3654", "dark": "#25405F" },
    "on-hero":      "#FFFFFF",
    "on-hero-2":    "#C5CEDB",
    "hero-track":   { "light": "#3A4D66", "dark": "#3E5573" },
    "hero-line":    { "light": "rgba(255,255,255,.14)", "dark": "rgba(255,255,255,.12)" },
    "gold":         "#F2C14E",
    "gold-hover":   "#F6CF6E",
    "gold-text":    { "light": "#8A6200", "dark": "#F2C14E" },
    "gold-soft":    { "light": "#FBEFC9", "dark": "#3A3115" },
    "on-gold":      "#0F2236",
    "good":         { "light": "#1E7A4F", "dark": "#5BD394" },
    "good-soft":    { "light": "#E3F3EA", "dark": "#12301F" },
    "on-good":      { "light": "#FFFFFF", "dark": "#0A1420" },
    "good-on-hero": "#5BD394",
    "bad":          { "light": "#B42318", "dark": "#FF8A7E" },
    "bad-soft":     { "light": "#FDECEA", "dark": "#3A1A17" },
    "grammar":      { "light": "#C2362B", "dark": "#FF8A7E" },
    "up":           { "light": "#8A6600", "dark": "#F2C14E" },
    "btn":          { "light": "#0F2236", "dark": "#F2C14E" },
    "on-btn":       { "light": "#FFFFFF", "dark": "#0F2236" },
    "btn-hover":    { "light": "#1D3550", "dark": "#F6CF6E" },
    "scrim":        { "light": "rgba(10,20,32,.42)", "dark": "rgba(0,0,0,.6)" },
    "theme-bar":    { "light": "#F4F5F7", "dark": "#0A1420" }
  },
  "space": {
    "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "14": "56px",
    "gutter-mobile": "16px", "gutter-desktop": "40px", "content-max": "1240px", "rail": "340px", "tap-min": "48px", "read-max": "68ch"
  },
  "radius": {
    "xs": "6px", "sm": "10px", "md": "14px", "lg": "18px", "xl": "22px", "pill": "999px"
  },
  "font": {
    "sans": "-apple-system, BlinkMacSystemFont, \"SF Pro Text\", Roboto, \"Segoe UI\", \"Noto Sans TC\", \"Noto Sans CJK TC\", \"PingFang TC\", \"Microsoft JhengHei\", sans-serif",
    "mono": "ui-monospace, \"SF Mono\", \"Roboto Mono\", Consolas, monospace",
    "size-display": "2.75rem", "size-title-1": "1.75rem", "size-title-2": "1.375rem", "size-headline": "1.0625rem",
    "size-read": "1.0625rem", "size-body": "0.9375rem", "size-callout": "0.8125rem", "size-caption": "0.75rem", "size-micro": "0.6875rem",
    "size-timer": "3.25rem",
    "weight-light": "300", "weight-regular": "400", "weight-medium": "500", "weight-semibold": "600", "weight-bold": "700",
    "leading-tight": "1.2", "leading-body": "1.5", "leading-read": "1.75"
  },
  "shadow": {
    "float": { "light": "0 18px 48px -18px rgba(15,34,54,.35), 0 2px 8px rgba(15,34,54,.08)", "dark": "0 18px 48px -12px rgba(0,0,0,.7), 0 0 0 1px #223246" },
    "seg":   { "light": "0 1px 3px rgba(15,34,54,.14)", "dark": "none" }
  },
  "motion": {
    "duration-fast": "140ms", "duration-base": "240ms", "duration-slow": "900ms", "duration-breathe": "2400ms",
    "ease-out": "cubic-bezier(.22,1,.36,1)", "ease-standard": "cubic-bezier(.4,0,.2,1)"
  }
}
