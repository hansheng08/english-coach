  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/pushguard/index.mjs"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
