{
  "name": "english-coach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "pnpm --filter web build",
    "e2e": "playwright test",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "arch": "depcruise --config .dependency-cruiser.cjs .",
    "test": "vitest run",
    "db:test": "node tooling/db-test.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm arch && pnpm test"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "dependency-cruiser": "^18.8.0",
    "eslint": "^10.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
