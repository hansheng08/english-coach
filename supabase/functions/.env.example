# supabase/functions/.env.example — 只有變數名稱（ARCHITECTURE §7.1、ADR-010 決定 1）。
# 本機真正的值放 supabase/functions/.env（已被 .gitignore 忽略）；正式環境用 supabase secrets set（Hansheng 本人輸入）。
# SUPABASE_URL、SUPABASE_PUBLISHABLE_KEYS、SUPABASE_SECRET_KEYS 由 Supabase 自動注入，不寫在這裡；自訂名稱不得以 SUPABASE_ 開頭。
GEMINI_API_KEY=
GEMINI_PAID_API_KEY=
GROQ_API_KEY=
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
APP_ALLOWED_ORIGINS=http://localhost:5173
